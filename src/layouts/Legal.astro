---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
}
const { title, heading, description } = Astro.props;
---

<Base title={title} description={description}>
  <Header />
  <main id="main" class="container-page pt-36 pb-24 sm:pt-44">
    <div class="mx-auto flex max-w-2xl flex-col gap-5">
      <h1 class="text-4xl text-mist-50 sm:text-5xl">{heading}</h1>
      <slot />
      <a href="/" class="mt-4 text-sm text-mist-500 transition-colors hover:text-mist-100">&larr; На главную</a>
    </div>
  </main>
  <Footer />
</Base>

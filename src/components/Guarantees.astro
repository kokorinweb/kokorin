---
import { guarantees } from '../data/content';
import Icon from './Icon.astro';
---

<section class="relative py-16 sm:py-20">
  <div class="container-page">
    <div class="card-glass overflow-hidden p-8 sm:p-12">
      <h2 class="reveal max-w-xl text-3xl text-mist-50 sm:text-4xl">{guarantees.title}</h2>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          guarantees.items.map((g, i) => (
            <div class="reveal" style={`--reveal-delay:${i * 90}ms`}>
              <Icon name="shield" class="size-6 text-gold-500" />
              <h3 class="mt-4 text-base text-mist-50">{g.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mist-300">{g.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

---
import { services } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="services" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-0 right-0 size-[34rem] bg-gold-600/10" aria-hidden="true"></div>
  <div class="container-page relative">
    <SectionHead eyebrow={services.eyebrow} title={services.title} subtitle={services.subtitle} />

    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        services.items.map((item, i) => (
          <article
            class="reveal card-glass card-hover flex flex-col p-7"
            style={`--reveal-delay:${(i % 3) * 90}ms`}
          >
            <span class="grid size-12 place-items-center rounded-2xl border border-gold-500/20 bg-gold-500/8 text-gold-400">
              <Icon name={item.icon} class="size-6" />
            </span>

            <h3 class="mt-6 text-xl text-mist-50">{item.title}</h3>
            <p class="mt-3 grow text-sm leading-relaxed text-mist-300">{item.text}</p>

            <ul class="mt-6 flex flex-col gap-2 border-t border-white/6 pt-5">
              {item.bullets.map((b) => (
                <li class="flex items-center gap-2.5 text-sm text-mist-300">
                  <Icon name="check" class="size-4 shrink-0 text-gold-500" />
                  {b}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

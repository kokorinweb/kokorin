---
import { pains } from '../data/content';
import SectionHead from './SectionHead.astro';
---

<section class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-1/3 -left-52 size-[30rem] bg-violet-600/10" aria-hidden="true"></div>
  <div class="container-page relative">
    <SectionHead eyebrow={pains.eyebrow} title={pains.title} subtitle={pains.subtitle} />

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {
        pains.items.map((item, i) => (
          <article
            class="reveal card-glass card-hover group p-7"
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="flex items-start gap-4">
              <span class="mt-1 grid size-9 shrink-0 place-items-center rounded-full border border-white/10 bg-white/5 font-display text-sm text-mist-500 transition-colors duration-300 group-hover:border-gold-500/40 group-hover:text-gold-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-lg text-mist-50 sm:text-xl">{item.title}</h3>
                <p class="mt-2.5 text-sm leading-relaxed text-mist-300 sm:text-base">{item.text}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import { cases } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="cases" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-1/4 left-1/2 size-[40rem] -translate-x-1/2 bg-violet-600/8" aria-hidden="true"></div>
  <div class="container-page relative">
    <SectionHead num={cases.num} eyebrow={cases.eyebrow} title={cases.title} />

    <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        cases.items.map((item, i) => (
          <a
            href={item.href}
            class="reveal card-glass card-hover group flex flex-col p-7"
            style={`--reveal-delay:${(i % 3) * 90}ms`}
          >
            <span class="text-xs tracking-[0.14em] text-mist-500 uppercase">{item.category}</span>

            <h3 class="mt-4 font-display text-2xl text-mist-50 transition-colors duration-300 group-hover:text-gold-400">
              {item.name}
            </h3>

            <p class="mt-3 grow text-sm leading-relaxed text-mist-300">{item.text}</p>

            <span class="mt-6 inline-flex items-center gap-2 border-t border-white/6 pt-5 text-sm text-mist-500 transition-colors duration-300 group-hover:text-gold-400">
              Открыть сайт
              <Icon
                name="arrowUpRight"
                class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </span>
          </a>
        ))
      }
    </div>

    <div class="reveal mt-14 flex flex-col items-center gap-6 text-center">
      <p class="max-w-lg font-display text-2xl text-mist-50 sm:text-3xl">{cases.outro.title}</p>
      <a
        href={cases.outro.cta.href}
        class="group glow-gold inline-flex items-center gap-2 rounded-pill bg-gold-500 px-8 py-4 font-semibold tracking-wide text-ink-950 uppercase transition-all duration-300 hover:scale-[1.03] hover:bg-gold-400"
      >
        {cases.outro.cta.label}
        <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

---
import { about } from '../data/content';
---

<section id="about" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-10 -right-40 size-[30rem] bg-gold-600/10" aria-hidden="true"></div>
  <div class="container-page relative grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:items-center lg:gap-20">
    <!-- Портретная заглушка: замени на реальное фото -->
    <div class="reveal relative mx-auto w-full max-w-sm lg:mx-0">
      <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-gold-500/20 via-transparent to-violet-600/20 blur-2xl" aria-hidden="true"></div>
      <div class="relative aspect-4/5 overflow-hidden rounded-[1.75rem] border border-white/10 bg-gradient-to-br from-ink-800 to-ink-950">
        <div
          class="absolute inset-0 opacity-25 [background-image:radial-gradient(circle_at_30%_20%,rgba(240,180,41,0.35),transparent_55%),radial-gradient(circle_at_75%_80%,rgba(124,92,255,0.3),transparent_55%)]"
        >
        </div>
        <span class="absolute inset-x-0 bottom-0 p-6 font-display text-sm text-mist-500">
          Фото / портрет
        </span>
      </div>
    </div>

    <div>
      <span
        class="reveal inline-flex items-center gap-2 rounded-pill border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-xs font-medium tracking-widest text-gold-400 uppercase"
      >
        <span class="size-1.5 rounded-full bg-gold-500"></span>
        {about.eyebrow}
      </span>

      <h2 class="reveal mt-5 text-4xl text-mist-50 sm:text-5xl" style="--reveal-delay:80ms">
        {about.title}
      </h2>

      <div class="mt-6 flex flex-col gap-4">
        {
          about.paragraphs.map((p, i) => (
            <p
              class="reveal text-base leading-relaxed text-mist-300"
              style={`--reveal-delay:${140 + i * 80}ms`}
            >
              {p}
            </p>
          ))
        }
      </div>

      <dl class="reveal mt-9 grid grid-cols-3 gap-4" style="--reveal-delay:400ms">
        {
          about.facts.map((f) => (
            <div class="rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-5">
              <dd class="font-display text-2xl text-gold-500">{f.value}</dd>
              <dt class="mt-1 text-xs leading-snug text-mist-500">{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

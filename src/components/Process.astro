---
import { process } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="process" class="relative overflow-clip py-24 sm:py-32">
  <div class="container-page">
    <SectionHead
      num={process.num}
      eyebrow={process.eyebrow}
      title={process.title}
      subtitle={process.subtitle}
      align="left"
    />

    <ol class="relative mt-16 grid gap-10 lg:grid-cols-4 lg:gap-6">
      <div
        class="absolute top-6 right-0 left-0 hidden h-px bg-gradient-to-r from-transparent via-white/12 to-transparent lg:block"
        aria-hidden="true"
      >
      </div>

      {
        process.steps.map((step, i) => (
          <li class="reveal relative" style={`--reveal-delay:${i * 110}ms`}>
            <span class="relative z-10 grid size-12 place-items-center rounded-full border border-gold-500/30 bg-ink-950 font-display text-sm text-gold-400">
              {step.n}
            </span>
            <h3 class="mt-6 text-xl text-mist-50">{step.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-mist-300">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-14">
      <a
        href={process.cta.href}
        class="group inline-flex items-center gap-2 rounded-pill border border-white/12 px-8 py-4 font-semibold tracking-wide text-mist-100 uppercase transition-colors duration-300 hover:border-gold-500/40 hover:bg-gold-500/8 hover:text-gold-400"
      >
        {process.cta.label}
        <Icon
          name="arrowUpRight"
          class="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </div>
</section>

---
import { pricing } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="pricing" class="relative overflow-clip py-24 sm:py-32">
  <!-- Цветные пятна под стеклом: без них стекло нечему преломлять -->
  <div class="aura top-1/4 left-[12%] size-[26rem] bg-gold-600/22" aria-hidden="true"></div>
  <div class="aura top-1/2 right-[8%] size-[24rem] bg-violet-600/20" aria-hidden="true"></div>
  <div class="aura bottom-10 left-1/2 size-[22rem] -translate-x-1/2 bg-gold-500/14" aria-hidden="true"></div>

  <div class="container-page relative">
    <SectionHead
      num={pricing.num}
      eyebrow={pricing.eyebrow}
      title={pricing.title}
      subtitle={pricing.subtitle}
    />

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        pricing.rows.map((row, i) => (
          <article
            class:list={[
              'reveal glass-card group',
              i === pricing.rows.length - 1 && 'sm:col-span-2 lg:col-span-3',
            ]}
            style={`--reveal-delay:${(i % 3) * 80}ms`}
          >
            <span class="glass-sheen" aria-hidden="true" />

            <div
              class:list={[
                'relative flex h-full flex-col p-7',
                i === pricing.rows.length - 1 && 'sm:flex-row sm:items-center sm:justify-between sm:gap-8',
              ]}
            >
              <div class="flex flex-col">
                <span class="font-display text-xs tracking-[0.22em] text-gold-400/80">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-5 text-lg leading-snug text-mist-50">{row.service}</h3>
                <p class="mt-2 text-sm leading-relaxed text-mist-300">{row.note}</p>
              </div>

              <p
                class:list={[
                  'font-display text-3xl text-transparent [background-image:linear-gradient(100deg,var(--color-mist-50),var(--color-gold-400))] bg-clip-text',
                  i === pricing.rows.length - 1 ? 'mt-7 whitespace-nowrap sm:mt-0' : 'mt-auto pt-7',
                ]}
              >
                {row.price}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-mist-500">{pricing.note}</p>
      <a
        href={pricing.cta.href}
        class="group glow-gold inline-flex shrink-0 items-center gap-2 rounded-pill bg-gold-500 px-7 py-4 font-semibold tracking-wide text-ink-950 uppercase transition-all duration-300 hover:scale-[1.03] hover:bg-gold-400"
      >
        {pricing.cta.label}
        <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

<style>
  .glass-card {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;

    /* Само стекло: размывает то, что под ним, и слегка поднимает насыщенность */
    backdrop-filter: blur(22px) saturate(160%);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));

    /* Кромка сверху светлее — как преломление на скошенном крае */
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.28),
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      inset 0 -18px 40px -30px rgb(255 255 255 / 0.4),
      0 18px 40px -26px rgb(0 0 0 / 0.85);

    transition:
      transform 0.55s var(--ease-out-soft),
      box-shadow 0.55s var(--ease-out-soft),
      background 0.55s var(--ease-out-soft);
  }

  .glass-card:hover {
    transform: translateY(-7px);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.15), rgb(255 255 255 / 0.05));
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.4),
      inset 0 0 0 1px rgb(240 180 41 / 0.22),
      inset 0 -18px 40px -30px rgb(255 255 255 / 0.5),
      0 26px 55px -26px rgb(0 0 0 / 0.9);
  }

  /* Блик скользит по стеклу при наведении */
  .glass-sheen {
    position: absolute;
    top: -60%;
    left: -75%;
    z-index: 0;
    width: 55%;
    height: 220%;
    rotate: 18deg;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(255 255 255 / 0.13),
      rgb(255 255 255 / 0.03),
      transparent
    );
    transition: translate 0.85s var(--ease-out-soft);
  }

  .glass-card:hover .glass-sheen {
    translate: 320% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-card:hover {
      transform: none;
    }
    .glass-card:hover .glass-sheen {
      translate: 0;
    }
  }
</style>

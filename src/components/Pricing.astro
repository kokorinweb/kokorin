---
import { pricing } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="pricing" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-1/4 left-1/2 size-[38rem] -translate-x-1/2 bg-gold-600/12" aria-hidden="true"></div>
  <div class="container-page relative">
    <SectionHead eyebrow={pricing.eyebrow} title={pricing.title} subtitle={pricing.subtitle} />

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        pricing.plans.map((plan, i) => (
          <article
            class={`reveal relative flex flex-col rounded-card p-7 sm:p-8 ${
              plan.featured
                ? 'border border-gold-500/30 bg-gradient-to-b from-gold-500/[0.09] to-white/[0.02] shadow-[0_30px_80px_-40px_rgba(240,180,41,0.6)] lg:-mt-4 lg:pb-12'
                : 'card-glass card-hover'
            }`}
            style={`--reveal-delay:${i * 100}ms`}
          >
            {plan.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-pill bg-gold-500 px-3.5 py-1 text-xs font-semibold whitespace-nowrap text-ink-950">
                Берут чаще всего
              </span>
            )}

            <h3 class="font-display text-xl text-mist-50">{plan.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-300">{plan.description}</p>

            <p class="mt-6 font-display text-4xl text-mist-50">{plan.price}</p>
            <p class="mt-1 text-sm text-mist-500">{plan.term}</p>

            <ul class="mt-7 flex grow flex-col gap-3 border-t border-white/8 pt-6">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-mist-300">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-gold-500" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            <a
              href="#contact"
              class={`mt-8 inline-flex items-center justify-center rounded-pill px-6 py-3.5 font-semibold transition-all duration-300 ${
                plan.featured
                  ? 'bg-gold-500 text-ink-950 hover:scale-[1.02] hover:bg-gold-400'
                  : 'border border-white/12 text-mist-100 hover:border-white/25 hover:bg-white/5'
              }`}
            >
              {plan.cta}
            </a>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-8 text-center text-sm text-mist-500">{pricing.note}</p>
  </div>
</section>

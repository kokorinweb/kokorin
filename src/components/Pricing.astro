---
import { pricing } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="pricing" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-1/4 left-1/2 size-[38rem] -translate-x-1/2 bg-gold-600/12" aria-hidden="true"></div>

  <div class="container-page relative">
    <SectionHead
      num={pricing.num}
      eyebrow={pricing.eyebrow}
      title={pricing.title}
      subtitle={pricing.subtitle}
    />

    <!-- Ценники-бирки: корешок с номером слева, цена справа, между ними перфорация -->
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        pricing.rows.map((row, i) => (
          <article class="reveal ticket group" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <div class="ticket-stub">
              <span class="font-display text-xs tracking-[0.2em] text-gold-500">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="ticket-body">
              <h3 class="text-lg leading-snug text-mist-50">{row.service}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-mist-500">{row.note}</p>

              <p class="mt-5 font-display text-3xl text-gold-500 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-0.5">
                {row.price}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-mist-500">{pricing.note}</p>
      <a
        href={pricing.cta.href}
        class="group glow-gold inline-flex shrink-0 items-center gap-2 rounded-pill bg-gold-500 px-7 py-4 font-semibold tracking-wide text-ink-950 uppercase transition-all duration-300 hover:scale-[1.03] hover:bg-gold-400"
      >
        {pricing.cta.label}
        <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

<style>
  .ticket {
    --notch: 0.85rem;
    --stub: 3.25rem;

    position: relative;
    display: grid;
    grid-template-columns: var(--stub) 1fr;
    border-radius: var(--radius-card);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.055), rgb(255 255 255 / 0.018));
    transition:
      transform 0.5s var(--ease-out-soft),
      background 0.5s var(--ease-out-soft);

    /* Круглые вырезы сверху и снизу на линии отрыва — как у настоящего билета */
    mask:
      radial-gradient(var(--notch) at var(--stub) 0, transparent 99%, #000 100%) top / 100% 51% no-repeat,
      radial-gradient(var(--notch) at var(--stub) 100%, transparent 99%, #000 100%) bottom / 100% 51% no-repeat;
  }

  .ticket:hover {
    transform: translateY(-6px);
    background: linear-gradient(150deg, rgb(240 180 41 / 0.1), rgb(255 255 255 / 0.02));
  }

  /* Корешок с номером */
  .ticket-stub {
    display: grid;
    place-items: center;
    padding-block: 1.75rem;
  }

  .ticket-stub > span {
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  /* Линия отрыва */
  .ticket-body {
    position: relative;
    padding: 1.75rem 1.75rem 1.75rem 1.5rem;
  }

  .ticket-body::before {
    content: '';
    position: absolute;
    top: var(--notch);
    bottom: var(--notch);
    left: 0;
    width: 1px;
    background-image: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.4) 0 7px,
      transparent 7px 13px
    );
    background-size: 1px 13px;
    transition: background-image 0.5s var(--ease-out-soft);
  }

  .ticket:hover .ticket-body::before {
    background-image: linear-gradient(
      to bottom,
      rgb(240 180 41 / 0.75) 0 6px,
      transparent 6px 12px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket:hover {
      transform: none;
    }
  }
</style>

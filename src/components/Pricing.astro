---
import { pricing } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="pricing" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura top-1/4 left-1/2 size-[38rem] -translate-x-1/2 bg-gold-600/12" aria-hidden="true"></div>

  <div class="container-page relative">
    <SectionHead
      num={pricing.num}
      eyebrow={pricing.eyebrow}
      title={pricing.title}
      subtitle={pricing.subtitle}
    />

    <div class="mt-14 overflow-hidden rounded-card border border-white/8">
      {
        pricing.rows.map((row, i) => (
          <div
            class="reveal group relative flex flex-col gap-1 border-b border-white/6 px-6 py-5 transition-colors duration-400 last:border-0 hover:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:px-8 sm:py-6"
            style={`--reveal-delay:${i * 60}ms`}
          >
            {/* Полоска у левого края выезжает на наведении */}
            <span
              class="absolute inset-y-0 left-0 w-px origin-top scale-y-0 bg-gold-500 transition-transform duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-y-100"
              aria-hidden="true"
            />

            <div class="sm:flex-1">
              <p class="text-lg text-mist-50 transition-transform duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5">
                {row.service}
              </p>
              <p class="mt-1 text-sm text-mist-500 transition-transform duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5">
                {row.note}
              </p>
            </div>

            <p class="font-display text-2xl whitespace-nowrap text-gold-500 sm:text-3xl">{row.price}</p>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-8 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-mist-500">{pricing.note}</p>
      <a
        href={pricing.cta.href}
        class="group glow-gold inline-flex shrink-0 items-center gap-2 rounded-pill bg-gold-500 px-7 py-4 font-semibold tracking-wide text-ink-950 uppercase transition-all duration-300 hover:scale-[1.03] hover:bg-gold-400"
      >
        {pricing.cta.label}
        <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

---
interface Props {
  num?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { num, eyebrow, title, subtitle, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'mx-auto items-center text-center' : 'items-start text-left';
---

<div class={`flex max-w-3xl flex-col gap-4 ${alignClass}`}>
  {
    (num || eyebrow) && (
      <span class="reveal inline-flex items-center gap-2.5 text-xs font-medium tracking-[0.2em] text-gold-400 uppercase">
        {num && <span class="font-display text-mist-500">{num}</span>}
        {num && eyebrow && <span class="h-px w-8 bg-gold-500/40" />}
        {eyebrow}
      </span>
    )
  }
  <h2 class="reveal text-4xl text-mist-50 sm:text-5xl lg:text-[3.4rem]" style="--reveal-delay:80ms">
    {title}
  </h2>
  {
    subtitle && (
      <p class="reveal max-w-2xl text-base leading-relaxed text-mist-300 sm:text-lg" style="--reveal-delay:160ms">
        {subtitle}
      </p>
    )
  }
</div>

---
import { contact, site } from '../data/content';
import Icon from './Icon.astro';
---

<section id="contact" class="relative overflow-clip py-24 sm:py-32">
  <div class="aura bottom-0 left-1/2 size-[42rem] -translate-x-1/2 bg-gold-600/16" aria-hidden="true"></div>

  <div class="container-page relative">
    <div
      class="card-glass grid gap-10 overflow-hidden p-8 sm:p-12 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:p-16"
    >
      <div>
        <span
          class="reveal inline-flex items-center gap-2 rounded-pill border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-xs font-medium tracking-widest text-gold-400 uppercase"
        >
          <span class="size-1.5 rounded-full bg-gold-500"></span>
          {contact.eyebrow}
        </span>

        <h2 class="reveal mt-5 text-4xl text-mist-50 sm:text-5xl" style="--reveal-delay:80ms">
          {contact.title}
        </h2>
        <p class="reveal mt-5 text-base leading-relaxed text-mist-300" style="--reveal-delay:160ms">
          {contact.subtitle}
        </p>

        <ul class="reveal mt-8 flex flex-col gap-3" style="--reveal-delay:240ms">
          {
            contact.bullets.map((b) => (
              <li class="flex items-center gap-3 text-sm text-mist-100">
                <Icon name="check" class="size-4 shrink-0 text-gold-500" />
                {b}
              </li>
            ))
          }
        </ul>

        <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay:320ms">
          <a
            href={site.telegram}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-pill border border-white/12 px-5 py-3 text-sm text-mist-100 transition-colors hover:border-gold-500/40 hover:bg-gold-500/8"
          >
            <Icon name="telegram" class="size-4 text-gold-500" />
            Telegram
          </a>
          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-pill border border-white/12 px-5 py-3 text-sm text-mist-100 transition-colors hover:border-gold-500/40 hover:bg-gold-500/8"
          >
            <Icon name="whatsapp" class="size-4 text-gold-500" />
            WhatsApp
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 rounded-pill border border-white/12 px-5 py-3 text-sm text-mist-100 transition-colors hover:border-gold-500/40 hover:bg-gold-500/8"
          >
            <Icon name="mail" class="size-4 text-gold-500" />
            {site.email}
          </a>
        </div>
      </div>

      <form id="lead-form" class="reveal flex flex-col gap-4" style="--reveal-delay:200ms" novalidate>
        <!-- Ловушка для ботов -->
        <input
          type="text"
          name="company_website"
          tabindex="-1"
          autocomplete="off"
          class="absolute -left-[9999px]"
          aria-hidden="true"
        />

        <label class="flex flex-col gap-2">
          <span class="text-sm text-mist-300">Как вас зовут</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            placeholder="Иван"
            class="rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3.5 text-mist-50 transition-colors placeholder:text-mist-500/60 focus:border-gold-500/50 focus:outline-none"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="text-sm text-mist-300">Телефон или Telegram</span>
          <input
            type="text"
            name="contact"
            required
            autocomplete="tel"
            placeholder="+7 900 000-00-00 или @nickname"
            class="rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3.5 text-mist-50 transition-colors placeholder:text-mist-500/60 focus:border-gold-500/50 focus:outline-none"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="text-sm text-mist-300">Пара слов о проекте</span>
          <textarea
            name="message"
            rows="4"
            placeholder="Ниша, что продаёте, есть ли сейчас сайт и трафик"
            class="resize-none rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3.5 text-mist-50 transition-colors placeholder:text-mist-500/60 focus:border-gold-500/50 focus:outline-none"
          ></textarea>
        </label>

        <button
          type="submit"
          class="glow-gold mt-2 inline-flex items-center justify-center gap-2 rounded-pill bg-gold-500 px-7 py-4 font-semibold text-ink-950 transition-all duration-300 hover:scale-[1.02] hover:bg-gold-400 disabled:opacity-60"
        >
          Отправить заявку
        </button>

        <p class="text-xs leading-relaxed text-mist-500">
          Нажимая кнопку, вы соглашаетесь с{' '}
          <a href="/privacy" class="underline decoration-mist-500/40 underline-offset-2 hover:text-mist-300">
            политикой обработки персональных данных</a>.
        </p>

        <p id="form-status" role="status" aria-live="polite" class="hidden text-sm"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const show = (text: string, ok: boolean) => {
    if (!status) return;
    status.textContent = text;
    status.className = `text-sm ${ok ? 'text-gold-400' : 'text-red-400'}`;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    const data = new FormData(form);
    if (data.get('company_website')) return; // honeypot

    if (!String(data.get('name') ?? '').trim() || !String(data.get('contact') ?? '').trim()) {
      show('Заполните имя и контакт — без них я не смогу ответить.', false);
      return;
    }

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Отправляю…';

    try {
      // TODO: подставить реальный endpoint (Telegram-бот, CRM или форм-сервис)
      const response = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(data)),
      });
      if (!response.ok) throw new Error(String(response.status));

      form.reset();
      show('Заявка ушла. Отвечу в течение двух часов.', true);
    } catch {
      show('Не получилось отправить. Напишите в Telegram — так быстрее.', false);
    } finally {
      button.disabled = false;
      button.textContent = 'Отправить заявку';
    }
  });
</script>

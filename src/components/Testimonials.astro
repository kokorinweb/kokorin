---
import { testimonials } from '../data/content';
import SectionHead from './SectionHead.astro';
---

<section class="relative overflow-clip py-24 sm:py-32">
  <div class="container-page">
    <SectionHead eyebrow={testimonials.eyebrow} title={testimonials.title} />

    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {
        testimonials.items.map((t, i) => (
          <figure
            class="reveal card-glass card-hover flex flex-col justify-between p-7 sm:p-8"
            style={`--reveal-delay:${(i % 2) * 90}ms`}
          >
            <span class="font-display text-5xl leading-none text-gold-500/35" aria-hidden="true">
              &laquo;
            </span>
            <blockquote class="mt-3 text-base leading-relaxed text-mist-100">{t.text}</blockquote>
            <figcaption class="mt-7 flex items-center gap-3 border-t border-white/6 pt-5">
              <span class="grid size-10 place-items-center rounded-full border border-gold-500/25 bg-gold-500/8 font-display text-sm text-gold-400">
                {t.author.charAt(0)}
              </span>
              <span>
                <span class="block text-sm font-medium text-mist-50">{t.author}</span>
                <span class="block text-xs text-mist-500">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

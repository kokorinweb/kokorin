---
import { nav, site } from '../data/content';
import Icon from './Icon.astro';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
>
  <div class="container-page">
    <div
      id="header-shell"
      class="relative mt-4 flex items-center justify-between gap-6 rounded-pill border border-transparent px-5 py-3 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
    >
      <a href="#top" class="font-display text-base font-semibold tracking-[0.06em] text-mist-50 sm:text-lg">
        {site.name}
      </a>

      <nav aria-label="Основная навигация" class="hidden items-center gap-8 lg:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="text-sm tracking-[0.12em] text-mist-300 uppercase transition-colors duration-300 hover:text-mist-50"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="#brief"
          class="hidden rounded-pill bg-gold-500 px-5 py-2.5 text-sm font-semibold tracking-wide text-ink-950 uppercase transition-transform duration-300 hover:scale-[1.03] sm:inline-flex"
        >
          Обсудить проект
        </a>

        <!-- details вместо кнопки: меню открывается и без JS -->
        <details id="mobile-nav" class="group lg:hidden">
          <summary
            aria-label="Меню"
            class="grid size-10 cursor-pointer place-items-center rounded-full border border-white/10 text-mist-100"
          >
            <Icon name="plus" class="size-5 transition-transform duration-300 group-open:rotate-45" />
          </summary>

          <nav
            aria-label="Мобильное меню"
            class="absolute inset-x-0 top-full mt-2 flex flex-col gap-1 rounded-card border border-white/10 bg-ink-900/95 p-3 backdrop-blur-xl"
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class="rounded-xl px-4 py-3 text-base tracking-wide text-mist-200 uppercase transition-colors hover:bg-white/5 hover:text-mist-50"
                >
                  {item.label}
                </a>
              ))
            }
            <a
              href="#brief"
              class="mt-1 rounded-xl bg-gold-500 px-4 py-3 text-center font-semibold tracking-wide text-ink-950 uppercase"
            >
              Обсудить проект
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    list-style: none;
  }
</style>

<script>
  const shell = document.getElementById('header-shell');
  const menu = document.getElementById('mobile-nav') as HTMLDetailsElement | null;

  const compact =
    'border-white/10 bg-ink-900/70 backdrop-blur-xl shadow-[0_18px_50px_-30px_rgba(0,0,0,0.9)]'.split(' ');

  const onScroll = () => {
    if (!shell) return;
    compact.forEach((c) => shell.classList.toggle(c, window.scrollY > 24));
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  menu?.querySelectorAll('nav a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.open = false;
    }),
  );
</script>

---
import { faq } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="faq" class="relative overflow-clip py-24 sm:py-32">
  <div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHead num={faq.num} eyebrow={faq.eyebrow} title={faq.title} align="left" />
    </div>

    <!-- Аккордеон: открытым остаётся один вопрос -->
    <div class="faq-list flex flex-col gap-3">
      {
        faq.items.map((item, i) => (
          <div
            class="reveal card-glass faq-item overflow-hidden transition-colors duration-400"
            style={`--reveal-delay:${i * 70}ms`}
            data-open={i === 0 ? 'true' : 'false'}
          >
            <h3>
              <button
                type="button"
                class="faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 px-6 py-5 text-left text-base text-mist-50 transition-colors duration-300 hover:text-gold-400 sm:text-lg"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`faq-panel-${i}`}
                id={`faq-trigger-${i}`}
              >
                {item.q}
                <Icon
                  name="plus"
                  class="faq-icon size-5 shrink-0 text-gold-500 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
                />
              </button>
            </h3>

            <div
              class="faq-panel"
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-trigger-${i}`}
            >
              <div>
                <p class="faq-answer px-6 pb-6 text-sm leading-relaxed text-mist-300 sm:text-base">
                  {item.a}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.items.map((i) => ({
        '@type': 'Question',
        name: i.q,
        acceptedAnswer: { '@type': 'Answer', text: i.a },
      })),
    })}
  />
</section>

<style>
  /* Открытый вопрос подсвечен кромкой */
  .faq-item[data-open='true'] {
    border-color: rgb(240 180 41 / 0.25);
  }
  .faq-item[data-open='true'] .faq-icon {
    rotate: 45deg;
  }

  /* Ответ появляется плавно: grid-rows анимируется, в отличие от height:auto */
  .faq-item[data-open='true'] .faq-panel {
    grid-template-rows: 1fr;
  }
  .faq-item[data-open='true'] .faq-answer {
    opacity: 1;
    transform: none;
  }
  .faq-answer {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.45s var(--ease-out-soft) 0.05s,
      transform 0.45s var(--ease-out-soft) 0.05s;
  }

  /* Без JS открыты все вопросы, иначе ответы недоступны */
  :root:not(.js) .faq-panel {
    grid-template-rows: 1fr;
  }
  :root:not(.js) .faq-answer {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.faq-list').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLElement>('.faq-item')];

    list.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLButtonElement>('.faq-trigger');
      if (!trigger) return;

      const item = trigger.closest<HTMLElement>('.faq-item');
      if (!item) return;

      const willOpen = item.dataset.open !== 'true';

      // Открытым остаётся только один вопрос — остальные закрываются
      items.forEach((other) => {
        const open = other === item && willOpen;
        other.dataset.open = String(open);
        other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', String(open));
      });
    });
  });
</script>

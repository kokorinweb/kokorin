---
import { faq } from '../data/content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="faq" class="relative overflow-clip py-24 sm:py-32">
  <div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionHead eyebrow={faq.eyebrow} title={faq.title} align="left" />
    </div>

    <div class="flex flex-col gap-3">
      {
        faq.items.map((item, i) => (
          <details
            class="reveal group card-glass overflow-hidden [&[open]]:border-gold-500/25"
            style={`--reveal-delay:${i * 70}ms`}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-base text-mist-50 marker:hidden sm:text-lg">
              {item.q}
              <Icon
                name="plus"
                class="size-5 shrink-0 text-gold-500 transition-transform duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] group-open:rotate-45"
              />
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-mist-300 sm:text-base">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.items.map((i) => ({
        '@type': 'Question',
        name: i.q,
        acceptedAnswer: { '@type': 'Answer', text: i.a },
      })),
    })}
  />
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>

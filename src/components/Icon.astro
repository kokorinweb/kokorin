    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18M9 21V9"/>',
  sparkles:
    '<path d="M12 3.5 13.8 9l5.7 1.9-5.7 1.9L12 18.3l-1.8-5.5L4.5 10.9 10.2 9 12 3.5Z"/><path d="M18.5 3.5v3M20 5h-3"/>',
  code: '<path d="m9 17-5-5 5-5"/><path d="m15 7 5 5-5 5"/>',
  trend: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  shield: '<path d="M12 3.2 20 6v6.2c0 4.6-3.3 7.6-8 8.8-4.7-1.2-8-4.2-8-8.8V6l8-2.8Z"/><path d="m9 12 2 2 4-4"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  telegram:
    '<path d="M21 4.5 2.8 11.4c-.8.3-.8 1.4 0 1.7l4.6 1.5 1.8 5.3c.2.7 1.1.8 1.6.3l2.5-2.4 4.6 3.4c.6.4 1.4.1 1.6-.6L22.4 5.6c.2-.8-.6-1.4-1.4-1.1Z"/>',
  whatsapp:
    '<path d="M20.5 11.6a8.5 8.5 0 0 1-12.7 7.4L3.5 20.5l1.6-4.2a8.5 8.5 0 1 1 15.4-4.7Z"/><path d="M8.8 9.2c.2 2.6 2.4 4.8 5 5 .6.1 1.2-.4 1.2-1v-.6l-1.8-.7-.8.9a5.6 5.6 0 0 1-2.2-2.2l.9-.8-.7-1.8h-.6c-.6 0-1.1.6-1 1.2Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name] ?? paths.check}
/>

---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<string, string> = {
  layout: '<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18M9 21V9"/>',
  cart: '<path d="M3 4h2.2l2.3 11.2a1.6 1.6 0 0 0 1.6 1.3h7.8a1.6 1.6 0 0 0 1.6-1.2L20 8H6"/><circle cx="9.5" cy="20" r="1.2"/><circle cx="17" cy="20" r="1.2"/>',
  sparkles:
    '<path d="M12 3.5 13.8 9l5.7 1.9-5.7 1.9L12 18.3l-1.8-5.5L4.5 10.9 10.2 9 12 3.5Z"/><path d="M18.5 3.5v3M20 5h-3"/>',
  flow: '<rect x="3" y="4" width="7" height="5" rx="1.5"/><rect x="14" y="15" width="7" height="5" rx="1.5"/><path d="M6.5 9v5.5a3 3 0 0 0 3 3H14"/>',
  refresh: '<path d="M20 11a8 8 0 0 0-13.6-4.6L4 8.6"/><path d="M4 4v4.6h4.6"/><path d="M4 13a8 8 0 0 0 13.6 4.6L20 15.4"/><path d="M20 20v-4.6h-4.6"/>',
  trend: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  arrowUpRight: '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  telegram:
    '<path d="M21 4.5 2.8 11.4c-.8.3-.8 1.4 0 1.7l4.6 1.5 1.8 5.3c.2.7 1.1.8 1.6.3l2.5-2.4 4.6 3.4c.6.4 1.4.1 1.6-.6L22.4 5.6c.2-.8-.6-1.4-1.4-1.1Z"/>',
  instagram:
    '<rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name] ?? paths.check}
/>

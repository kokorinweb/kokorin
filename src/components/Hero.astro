---
import { hero } from '../data/content';
import Icon from './Icon.astro';
---

<section id="top" class="relative isolate overflow-hidden pt-44 pb-20 sm:pt-48 lg:pt-52">
  <!-- Свечения и сетка -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="aura -top-40 left-1/2 size-[46rem] -translate-x-1/2 bg-gold-600/18"></div>
    <div class="aura top-40 -left-40 size-[32rem] bg-violet-600/16"></div>
    <div class="aura top-20 -right-32 size-[28rem] bg-gold-500/10"></div>
    <div
      class="absolute inset-0 opacity-[0.14] [background-image:linear-gradient(to_right,rgba(255,255,255,0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.07)_1px,transparent_1px)] [background-size:64px_64px] [mask-image:radial-gradient(ellipse_75%_55%_at_50%_10%,#000,transparent)]"
    >
    </div>
  </div>

  <div class="container-page flex flex-col items-center text-center">
    <span
      class="reveal inline-flex items-center gap-2.5 rounded-pill border border-gold-500/25 bg-gold-500/[0.07] px-4 py-2 text-xs font-medium tracking-[0.18em] text-gold-400 uppercase sm:text-sm"
    >
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-gold-500 opacity-70"></span>
        <span class="relative inline-flex size-2 rounded-full bg-gold-500"></span>
      </span>
      {hero.badge}
    </span>

    <h1
      class="reveal mt-8 w-full text-[clamp(2.75rem,13vw,9rem)] leading-[0.95] tracking-[-0.04em] text-mist-50"
      style="--reveal-delay:100ms"
    >
      <span class="text-gradient-gold">{hero.title}</span>
    </h1>

    <p
      class="reveal mt-7 w-full max-w-2xl text-base leading-relaxed text-mist-300 sm:text-lg"
      style="--reveal-delay:200ms"
    >
      {hero.subtitle}
    </p>

    <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row sm:items-center" style="--reveal-delay:300ms">
      <a
        href={hero.primaryCta.href}
        class="group glow-gold inline-flex items-center justify-center gap-2 rounded-pill bg-gold-500 px-7 py-4 font-semibold tracking-wide text-ink-950 uppercase transition-all duration-300 hover:scale-[1.03] hover:bg-gold-400"
      >
        {hero.primaryCta.label}
        <Icon name="arrow" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
      <a
        href={hero.secondaryCta.href}
        class="inline-flex items-center justify-center gap-2 rounded-pill border border-white/12 px-7 py-4 font-medium tracking-wide text-mist-100 uppercase transition-colors duration-300 hover:border-white/25 hover:bg-white/5"
      >
        {hero.secondaryCta.label}
      </a>
    </div>

    <!-- Метрики -->
    <dl
      class="reveal mt-16 grid w-full max-w-3xl grid-cols-1 gap-px overflow-hidden rounded-card border border-white/8 bg-white/8 sm:grid-cols-3"
      style="--reveal-delay:400ms"
    >
      {
        hero.metrics.map((m) => (
          <div class="flex flex-col items-center gap-1.5 bg-ink-950/85 px-4 py-7 backdrop-blur-sm">
            <dt class="sr-only">{m.label}</dt>
            <dd class="font-display text-4xl text-mist-50">
              {m.prefix && <span class="text-2xl text-mist-500">{m.prefix}</span>}
              <span class="counter" data-to={m.value} data-pad={m.pad ? '2' : '0'}>
                {m.pad ? String(m.value).padStart(2, '0') : m.value}
              </span>
              {m.suffix}
            </dd>
            <p class="text-sm tracking-wide text-mist-500 uppercase">{m.label}</p>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>('.counter');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const format = (n: number, pad: number) => {
    const value = Math.round(n);
    return pad > 0 ? String(value).padStart(pad, '0') : String(value);
  };

  const run = (el: HTMLElement) => {
    const to = Number(el.dataset.to ?? 0);
    const pad = Number(el.dataset.pad ?? 0);
    if (reduce) {
      el.textContent = format(to, pad);
      return;
    }
    const duration = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      el.textContent = format(to * (1 - Math.pow(1 - p, 3)), pad);
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        run(entry.target as HTMLElement);
        io.unobserve(entry.target);
      });
    },
    { threshold: 0.6 },
  );

  counters.forEach((c) => io.observe(c));
</script>

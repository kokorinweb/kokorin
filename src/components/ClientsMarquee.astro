---
import { clients } from '../data/content';
const row = [...clients, ...clients];
---

<section class="relative border-y border-white/6 bg-ink-900/40 py-8" aria-label="Клиенты">
  <div
    class="flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,#000_12%,#000_88%,transparent)]"
  >
    <ul class="flex shrink-0 animate-[marquee_42s_linear_infinite] items-center gap-14 pr-14 motion-reduce:animate-none">
      {
        row.map((name) => (
          <li class="font-display text-lg whitespace-nowrap text-mist-500/70 transition-colors duration-300 hover:text-mist-100">
            {name}
          </li>
        ))
      }
    </ul>
    <ul
      aria-hidden="true"
      class="flex shrink-0 animate-[marquee_42s_linear_infinite] items-center gap-14 pr-14 motion-reduce:hidden"
    >
      {
        row.map((name) => (
          <li class="font-display text-lg whitespace-nowrap text-mist-500/70">{name}</li>
        ))
      }
    </ul>
  </div>
</section>
